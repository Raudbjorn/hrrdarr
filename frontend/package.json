{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "npm run check:api && svelte-check --tsconfig ./tsconfig.json",
    "generate:api": "cargo run --locked --manifest-path ../Cargo.toml --bin generate-api --",
    "check:api": "npm run generate:api -- --check",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "svelte-check": "4.7.6"
  }
}
